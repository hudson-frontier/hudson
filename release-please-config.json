{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "9c2288ba0389676ada57a2a79d8636c266931eb6",
  "draft-pull-request": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "include-component-in-tag": false,
      "versioning": "always-bump-patch",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(!@.source && (@.name.value=='hudson-harness' || @.name.value=='hudson-core' || @.name.value=='hudson-server' || @.name.value=='hudson-worker' || @.name.value=='hudson-api-fixture' || @.name.value=='hudson-temporal' || @.name.value=='hudson-sandbox-transport'))].version"
        },
        {
          "type": "toml",
          "path": "integrations/harbor/pyproject.toml",
          "jsonpath": "$.project.version"
        }
      ]
    }
  }
}
